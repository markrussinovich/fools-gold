# Fool's Gold — environment-variable seams (example configuration).
#
# Copy to .env (git-ignored) or export in your shell. Every deployment- and
# infrastructure-specific value in this repository is injected through the
# variables below; no endpoint, credential, account, or host name is
# hard-coded anywhere in the tree.

# ---- LLM judge (scripts/gpt55.py — all judged metrics go through it) -------
# Default transport: the public OpenAI API, model pinned to
# gpt-4.1-2025-04-14 (never swap judges mid-experiment).
export JUDGE_BACKEND=openai            # openai (default) | azure
export OPENAI_API_KEY=sk-your-key-here

# Azure OpenAI transport (JUDGE_BACKEND=azure): requires a deployment NAMED
# "gpt-4.1" of the same pinned model on your resource, plus Entra ID auth.
# export AZURE_JUDGE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
# export AZURE_JUDGE_MI_CLIENT_ID=<your-managed-identity-client-id>  # or "cli"
#                                  # for the az CLI credential; unset =
#                                  # DefaultAzureCredential

# Opt-in Anthropic fallback for judge outages (off by default):
# export JUDGE_ANTHROPIC_FALLBACK=1
# export JUDGE_ANTHROPIC_MODEL=<model-id>

# Optional second-judge-family replication on an Azure AI Foundry Responses
# endpoint (scripts/gpt55.py make_responses_chat_client; same Entra ID auth
# seams as JUDGE_BACKEND=azure). JUDGE_RESPONSES_MODEL is the deployment
# name on your resource (the deployment pins the snapshot):
# export RESPONSES_JUDGE_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1/responses
# export JUDGE_RESPONSES_MODEL=<deployment-name>

# ---- Hugging Face ----------------------------------------------------------
# export HF_HOME=/path/to/hf-cache     # model/dataset cache location
# export HF_HUB_OFFLINE=1              # air-gapped runs after pre-download

# ---- data ------------------------------------------------------------------
# scripts/data/download_public.sh materializes the pipeline-read files under
# data/eval + data/archive (raw inspection copies under data/public); see
# scripts/data/README.md for the consumer map. The AdvBench source can be
# re-pointed, but must keep the converted python-literal 'content' schema
# that the script writes (NOT the raw goal/target harmful_behaviors.csv):
# export ADVBENCH_CSV=data/archive/advbench_train.csv

# ---- pipeline knobs (scripts/line.sh) ---------------------------------------
# export LINE=demo_alchemy             # which configs/lines/<LINE>.json to run
# export STAGES=b0,b1,post             # stage subset
# export B0_SIGNED_OFF=1               # proceed past the human corpus review
# export CUDA_VISIBLE_DEVICES=0        # GPU selection
# export ANTIABLIT_PHASE_LOCK=/tmp/antiablit_gpu_phase.lock
#                                      # cross-process GPU phase lock path
#                                      # (override for disjoint GPU lanes)

# ---- stage-level knobs (optional; defaults are the registered values) -------
# export B1_GPUS=0,1,2,3               # GPU set for B1 train/eval workers
#                                      # (falls back to CUDA_VISIBLE_DEVICES)
# export C7_GROUP_WORKERS=4            # C7 judge-grouping worker count
# export C12_SERVED_INFLIGHT=8         # C12 served-backend request concurrency
# export C18XA_REGISTRY=<path>.json    # override the C18XA attack-set registry
# export C18_ALLOW_FALLBACK=1          # C18: permit a non-accepted attack state
#                                      # (analysis only — not comparable to the paper)

# ---- smoke/debug knobs (development only — NEVER for reported results) --------
# export B0_SMOKE_N=8                  # truncate B0 stages to n items
# export B0_ONLY_IDS="id1 id2"         # restrict B0 to specific prompt ids
# export B1_STEPS=10                   # shorten the B1 seed SFT (smoke)
# export B1_SMOKE_STEPS=2              # DPO GPU smoke (adapter sanity only)
# export B1_SKIP_MERGE=1               # skip the full-weight merge (smoke)
# export B1_PAIR_MICRO=1               # pair-loss micro-batch override
